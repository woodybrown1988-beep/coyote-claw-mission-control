{
  "functionsUnderTest": [
    {
      "module": "mission-control/server.js",
      "export": "formatCount"
    },
    {
      "module": "mission-control/server.js",
      "export": "formatJobAge"
    },
    {
      "module": "mission-control/server.js",
      "export": "formatUtc"
    },
    {
      "module": "mission-control/server.js",
      "export": "statusPillClass"
    }
  ],
  "tests": [
    {
      "name": "statusPillClass",
      "command": "node --test test/status-pill-class.test.js"
    }
  ],
  "mutants": [
    {
      "name": "formatUtc-old-whole-second-only",
      "module": "mission-control/server.js",
      "find": ".replace(/\\.\\d{3}Z$/, ' UTC')",
      "replace": ".replace('.000Z', ' UTC')"
    },
    {
      "name": "statusPillClass-escalated-not-refused",
      "module": "mission-control/server.js",
      "find": "|(?:^|\\s)escalated(?:\\s|$)",
      "replace": ""
    }
  ]
}
