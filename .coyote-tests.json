      "find": "  if (verdict === 'theatre') {\n    parts.push('integrity theatre/proves-nothing');\n  } else if (verdict === 'accept') {\n    const caughtCount = countCaughtByMutant(detail && detail.perFunction);\n    if (caughtCount > 0) {\n      parts.push(`mutant-killed (${caughtCount} fns)`);\n    }\n  }\n\n",
