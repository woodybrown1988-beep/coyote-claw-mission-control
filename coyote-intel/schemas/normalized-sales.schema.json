{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized-sales.schema.json",
  "title": "Lightspeed K-Series normalized sales record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_system",
    "business_location_id",
    "raw_record_hash"
  ],
  "properties": {
    "source_system": { "const": "lightspeed-kseries" },
    "business_id": { "type": ["string", "null"] },
    "business_location_id": { "type": ["string", "null"] },
    "business_timezone": { "type": ["string", "null"] },
    "account_reference": { "type": ["string", "null"] },
    "account_fisc_id": { "type": ["string", "null"] },
    "receipt_id": { "type": ["string", "null"] },
    "sale_type": { "type": ["string", "null"] },
    "cancelled": { "type": "boolean" },
    "time_opened": { "type": ["string", "null"], "format": "date-time" },
    "time_closed": { "type": ["string", "null"], "format": "date-time" },
    "line_id": { "type": ["string", "null"] },
    "parent_line_id": { "type": ["string", "null"] },
    "sku": { "type": ["string", "null"] },
    "item_name": { "type": ["string", "null"] },
    "quantity": { "type": ["number", "null"] },
    "gross_amount": { "type": ["number", "null"] },
    "net_amount": { "type": ["number", "null"] },
    "tax_amount": { "type": ["number", "null"] },
    "discount_amount": { "type": ["number", "null"] },
    "accounting_group_id": { "type": ["string", "null"] },
    "category_ids": { "type": "array", "items": { "type": "string" } },
    "revenue_center_id": { "type": ["string", "null"] },
    "staff_id": { "type": ["string", "null"] },
    "device_id": { "type": ["string", "null"] },
    "void_reason": { "type": ["string", "null"] },
    "payment_uuid": { "type": ["string", "null"] },
    "payment_fisc_id": { "type": ["string", "null"] },
    "payment_method_id": { "type": ["string", "null"] },
    "payment_method_code": { "type": ["string", "null"] },
    "payment_amount": { "type": ["number", "null"] },
    "tip_amount": { "type": ["number", "null"] },
    "external_reference": { "type": ["string", "null"] },
    "refund_initial_account_id": { "type": ["string", "null"] },
    "refund_previous_account_id": { "type": ["string", "null"] },
    "raw_record_hash": { "type": "string" },
    "stable_key": { "type": "string" }
  }
}
